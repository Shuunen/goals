{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["package.json", "pnpm-lock.yaml"],
  "tasks": {
    "build:tsc": {
      "dependsOn": ["lint:install"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tsconfig*.json"]
    },
    "build:vite": {
      "dependsOn": ["build:tsc", "lint:install"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "index.html", "public/**", "tsconfig*.json", "vite.config.ts"],
      "outputs": ["dist/**"]
    },
    "lint:format": {
      "dependsOn": ["lint:install"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", ".github/**", ".oxfmtrc.jsonc", "*.{ts,js,json,md,yaml,yml}"]
    },
    "lint:install": {
      "inputs": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"]
    },
    "lint:issues": {
      "dependsOn": ["lint:install"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.{ts,tsx}", ".oxlintrc.json", "tsconfig*.json"]
    },
    "lint:knip": {
      "dependsOn": ["lint:install"]
    },
    "lint:repo": {
      "dependsOn": ["lint:install", "build:tsc", "build:vite"],
      "inputs": ["$TURBO_DEFAULT$", "dist/**"]
    },
    "lint:types": {
      "dependsOn": ["lint:install"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.{ts,tsx}", "tsconfig*.json"]
    },
    "test:unit": {
      "dependsOn": ["lint:install"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.{ts,tsx}", "vite.config.ts"],
      "outputs": ["coverage/**"]
    }
  }
}
